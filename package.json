{
  "name": "tmdb-movie-finder",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "portless moviefinder --lan --app-port 8989 nuxt dev",
    "dev:cucumber": "nuxt dev --port 8990",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .js,.ts,.vue .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:cucumber:install": "playwright install --with-deps chromium",
    "test:cucumber:run": "cucumber-js --config features/cucumber.json",
    "test:cucumber": "WAIT_ON_TIMEOUT=30000 start-server-and-test dev:cucumber http://localhost:8990 test:cucumber:run",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.5",
    "@nuxtjs/i18n": "^10.6.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "std-env": "^4.2.0",
    "vue": "3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cucumber/cucumber": "^13.2.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@unocss/nuxt": "^66.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "playwright": "^1.63.0",
    "portless": "^0.15.6",
    "sass": "^1.104.0",
    "start-server-and-test": "^3.0.12",
    "unocss": "^66.10.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "version": "1.4.3",
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.2": true
  }
}
