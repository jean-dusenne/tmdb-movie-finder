{
  "name": "tmdb-movie-finder",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "portless moviefinder --lan --app-port 8989 nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.5",
    "@nuxtjs/i18n": "^10.6.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "std-env": "^4.2.0",
    "vue": "3.5.42",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@unocss/nuxt": "^66.8.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "portless": "^0.15.6",
    "sass": "^1.103.1",
    "unocss": "^66.8.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs}": [
      "npx eslint --fix"
    ]
  },
  "version": "1.4.3",
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  }
