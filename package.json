    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.5",
    "@nuxtjs/i18n": "^10.6.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.2.1",
    "nuxt": "^4.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "vue": "3.5.32",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.0.0",
    "@unocss/nuxt": "^66.6.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "happy-dom": "^20.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "sass": "^1.97.3",
    "unocss": "^66.6.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
